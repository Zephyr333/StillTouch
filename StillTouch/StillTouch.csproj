<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyName>StillTouch</AssemblyName>
    <RootNamespace>StillTouch</RootNamespace>
    <Version>1.1.1-rc.2</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Product>StillTouch</Product>
    <Description>Convert confirmed stationary single-finger touch gestures into mouse clicks.</Description>
    <Authors>Zephyr333</Authors>
    <Copyright>Copyright © 2026 Zephyr333</Copyright>
    <RepositoryUrl>https://github.com/Zephyr333/StillTouch</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StillTouch.Core\StillTouch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="StillTouch.AppIcon.ico" />
  </ItemGroup>

  <Target Name="RemovePublishedSymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)StillTouch.Core.pdb" />
  </Target>

</Project>
